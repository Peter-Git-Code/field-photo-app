    {
      "t": "table",
      "head": [
        "Use",
        "Typical filter"
      ],
      "rows": [
        [
          "Wide aperture in full sun (portraits)",
          "ND4–ND8"
        ],
        [
          "Video at the 180° shutter",
          "ND8–ND64 or variable"
        ],
        [
          "Silky waterfall in daylight",
          "ND64"
        ],
