          "1/30 s"
        ],
        [
          "ND8",
          "0.9",
          "3",
          "1/15 s"
        ],
        [
          "ND64",
          "1.8",
          "6",
          "1/2 s"
        ],
        [
          "ND1000",
          "3.0",
          "10",
          "8 s"
        ]
      ]
